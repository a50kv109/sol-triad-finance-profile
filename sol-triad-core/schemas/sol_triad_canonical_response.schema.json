{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sol-triad.org/schemas/v1/canonical-response.json",
  "title": "SolTriadCanonicalResponse",
  "description": "Deterministic response format from SOL-Triad Core. Execution is never permitted by the kernel.",
  "type": "object",
  "required": [
    "request_id",
    "protocol_version",
    "verdict",
    "pairwise_checks",
    "simulated_values",
    "simulated_flags",
    "diagnostics",
    "execution_permitted"
  ],
  "additionalProperties": false,
  "properties": {
    "request_id": { "type": "string" },
    "protocol_version": { "type": "string" },
    "verdict": { "type": "string", "enum": ["PASS", "REVIEW", "FAIL"] },
    "pairwise_checks": {
      "type": "object",
      "required": ["P_SC", "P_SD", "P_CD"],
      "additionalProperties": false,
      "properties": {
        "P_SC": {
          "type": "object",
          "required": ["is_valid", "verdict", "diagnostics"],
          "properties": {
            "is_valid": { "type": "boolean" },
            "verdict": { "type": "string", "enum": ["PASS", "REVIEW", "FAIL"] },
            "diagnostics": { "type": "array" }
          }
        },
        "P_SD": {
          "type": "object",
          "required": ["is_valid", "verdict", "diagnostics"],
          "properties": {
            "is_valid": { "type": "boolean" },
            "verdict": { "type": "string", "enum": ["PASS", "REVIEW", "FAIL"] },
            "diagnostics": { "type": "array" }
          }
        },
        "P_CD": {
          "type": "object",
          "required": ["is_valid", "verdict", "diagnostics"],
          "properties": {
            "is_valid": { "type": "boolean" },
            "verdict": { "type": "string", "enum": ["PASS", "REVIEW", "FAIL"] },
            "diagnostics": { "type": "array" }
          }
        }
      }
    },
    "simulated_values": { "type": "object", "additionalProperties": { "type": "number" } },
    "simulated_flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "type": "string", "enum": ["INFO", "WARNING", "ERROR"] },
          "message": { "type": "string" },
          "primitive": { "type": ["string", "null"] },
          "field_name": { "type": ["string", "null"] }
        }
      }
    },
    "execution_permitted": {
      "type": "boolean",
      "const": false,
      "description": "Strictly false. The verification kernel evaluates consistency, but NEVER executes or authorizes execution."
    }
  }
}
